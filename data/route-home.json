ticleCount":3,"lastUpdated":"2026-06-13","issueIds":["ic_ai_coding_precommit_structured_checks"],"activeIssueIds":[],"relatedCardIds":[],"relatedResearchIds":[]},{"id":"tc_mathematical_modeling_framework","title":"数学建模体系理解","status":"active","issueCountDeclared":1,"articleCount":1,"lastUpdated":"2026-06-13","issueIds":["ic_mathematical_modeling_philosophy_method_tool"],"activeIssueIds":[],"relatedCardIds":[],"relatedResearchIds":[]},{"id":"tc_local_llm_evaluation_engineering","title":"本地大模型评测工程","status":"active","issueCountDeclared":2,"articleCount":3,"lastUpdated":"2026-06-13","issueIds":["ic_local_llm_eval_privacy_cost_reproducibility","ic_llm_eval_domain_specific_benchmark_workflow_evolution"],"activeIssueIds":["ic_llm_eval_domain_specific_benchmark_workflow_evolution"],"relatedCardIds":[],"relatedResearchIds":[]},{"id":"tc_mobile_os_agent_mobile_entry_reconstruction","title":"操作系统级手机Agent与移动入口重构","status":"candidate_topic","issueCountDeclared":1,"articleCount":2,"lastUpdated":"2026-06-13","issueIds":["ic_mobile_os_agent_mobile_entrypoint_shift"],"activeIssueIds":["ic_mobile_os_agent_mobile_entrypoint_shift"],"relatedCardIds":[],"relatedResearchIds":[]},{"id":"tc_ai_engineering_guardrails_verification_governance","title":"AI工程护栏与验证治理体系","status":"candidate_topic","issueCountDeclared":1,"articleCount":2,"lastUpdated":"2026-06-13","issueIds":["ic_ai_engineering_guardrails_verification_bottleneck_shift"],"activeIssueIds":["ic_ai_engineering_guardrails_verification_bottleneck_shift"],"relatedCardIds":[],"relatedResearchIds":[]},{"id":"tc_org_level_testing_system_quality_enablement","title":"组织级测试体系与质量赋能","status":"parking_topic","issueCountDeclared":3,"articleCount":4,"lastUpdated":"2026-06-14","issueIds":["ic_gamified_quality_efficiency_system_design","ic_qa_lifecycle_quality_governance_transformation","ic_ci_cd_multi_stage_quality_gates_pipeline"],"activeIssueIds":["ic_qa_lifecycle_quality_governance_transformation"],"relatedCardIds":[],"relatedResearchIds":[]},{"id":"tc_data_platform_evolution_analytics","title":"数据分析平台演进与智能化架构","status":"active","issueCountDeclared":2,"articleCount":5,"lastUpdated":"2026-06-13","issueIds":[],"activeIssueIds":[],"relatedCardIds":[],"relatedResearchIds":[]}],"research":[{"id":"research-ad73a1b2b62b4012","type":"research","title":"云厂商盈利，不能只看一个毛利率","category":"深度研究","topicId":null,"status":"published","updatedAt":"2026-07-16T17:34:00Z","createdAt":"2026-07-16T17:34:00Z","canonicalQuestion":"","mtime":"2026-07-16T17:29:37.877262+00:00","summary":"- 六家云厂商目前没有一个可以直接横向排序的“统一毛利率”。 AWS、Google Cloud 披露的是混合分部经营利润，Alibaba 披露的是 adjusted EBITA，Tencent 给出的是云业务 adjusted operating profit 锚但没有同步披露收入边界，Huawei 有三种互不等价的收入视图却没有云分部成本，Azure 只披露收入下限并把利润留在更大的 Intelligent Cloud 口径中。把这些数字排成一列，会制造精确感，而不是可比性。 - 公开材料已经足够回答“盈利来自哪里、风险在哪里”，但不足以给每家公司一个可信的统一毛利点估计。 当前最可靠的做法是并列保留四种视角：披露利润锚、经济基础","diagramCount":0},{"id":"ai-cloud-competition-aws","type":"research","title":"AI 时代云厂商竞争格局与华为云发展策略：AWS 对标图文增强版","category":"厂商观察","topicId":null,"status":"published","updatedAt":null,"createdAt":null,"canonicalQuestion":"","mtime":"2026-06-22T10:30:03.243534+00:00","summary":"--- 本图要表达的判断 ：AWS 和华为云面对同一轮 AI 竞争，但选择了完全不同的战略路线——AWS 用\"芯片降本→算力绑定→平台聚合→Agent 锁定→消费闭环\"构建全球规模飞轮；华为云用\"国产算力→行业模型→流程智能→政企可信→知识沉淀\"构建中国政企闭环。两条路线的差异不是技术差距，而是市场结构、约束条件和客户群决定的。 mermaid flowchart LR subgraph AWS[\"AWS 路线：全球规模飞轮\"] B1[\"Trainium：降低训练/推理单位成本\"] --> B2[\"Project Rainier：绑定模型公司与大客户承诺\"] B2 --> B3[\"Bedrock：聚合模型，降低企业采用风险\"] B3","diagramCount":5},{"id":"ai-cloud-competition-ibm","type":"research","title":"IBM 在 AI 时代的软件、硬件、咨询销售与竞争力演化：图文增强版","category":"厂商观察","topicId":null,"status":"published","updatedAt":null,"createdAt":null,"canonicalQuestion":"","mtime":"2026-06-22T10:33:39.154921+00:00","summary":"--- 本图要表达的判断 ：IBM 不是卖单点 AI 产品，而是在构建\"咨询牵引需求 → watsonx/Granite 承载 AI 能力 → OpenShift 支撑混合云部署 → IBM Z/LinuxONE 承载关键系统 → governance 形成长期治理续费\"的企业 AI 转型闭环。每个环节都产生收入，前端（咨询）引流、后端（软件+硬件+续费）锁定。客户一旦进入这一闭环，转换成本极高。这是 IBM 与 AWS/Azure 的本质差异——不是让客户\"上云\"，而是让客户\"在核心系统里用 AI\"。 mermaid flowchart TD A[\"Consulting 识别业务场景与转型需求\"] --> B[\"watsonx/G","diagramCount":6},{"id":"agent-runtime-trustworthy-execution","type":"research","title":"Agent Runtime 可信执行：企业 Agent 商业化的隐藏基础设施","category":"技术趋势","topicId":null,"status":"published","updatedAt":null,"createdAt":null,"canonicalQuestion":"","mtime":"2026-07-09T03:43:32.862914+00:00","summary":"核心判断：模型决定 Agent 能做什么，Runtime 决定企业敢让 Agent 做什么。 --- Agent 商业竞争正在从\"模型能力竞争\"转向\"Runtime 可信执行竞争\"。企业不会因为 Agent\"会做事情\"就把核心流程交出去，而是因为 Runtime 能保证\"出了问题可以停、可以看、可以恢复、可以追责\"，才敢规模化部署。Checkpoint 让错误可恢复，Trace 让行为可解释，Governance 让规模化成为可能。 三个核心判断 ： 1. 模型解决\"能不能完成任务\" ——GPT-4、Claude、DeepSeek 的能力边界在扩展，但这只是必要条件 2. Runtime 解决\"敢不敢交给企业\" ——没有可回退、可观","diagramCount":4},{"id":"agentarts-industry-ecosystem","type":"research","title":"AgentArts 研讨会研究框架（视觉增强版）","category":"行业观察","topicId":null,"status":"published","updatedAt":null,"createdAt":null,"canonicalQuestion":"","mtime":"2026-06-30T01:45:18.627246+00:00","summary":"Source Material: 5 active Issue Cards + prior research packs Visual Enhancement: 6 Mermaid 图 + 7 表格四件套 --- 本报告由 GPT 基于 KFC Issue Card 素材库和外部搜索生成，经视觉增强（Step 7: 观点驱动图例）处理。 - 所有数据标注了来源或\"待验证\"；未编造数据 - 所有 Mermaid 图包含四件套：visual thesis + 图本体 + 读图说明 + 不能误读为 - 表格包含结论/启发列（对比表）或破坏的战略环节列（风险表） - ⚠️ 类比材料修正 ：原报告引用 Notion 作为直接证据，已按 ski","diagramCount":6},{"id":"ai-cloud-agent-token-economy","type":"research","title":"AI 云与智能体 Token 经济战略研究报告","category":"商业观察","topicId":null,"status":"published","updatedAt":null,"createdAt":null,"canonicalQuestion":"","mtime":"2026-06-12T06:32:16.620691+00:00","summary":"本报告的核心结论是：智能体时代的云竞争，不再只是“谁有更多 GPU / NPU”，而是“谁能把行业场景中的真实任务转化为可计量、可治理、可复购、可沉淀的有效 Token 消耗，并把这些 Token 消耗向 MaaS、Agent Runtime、数据湖、工具调用、通算、存储、网络、安全和行业解决方案层层变现”。 对华为云而言，Agent 不应被理解为一个独立应用产品，而应被定位为 AI 云消费入口、行业流程改造界面、Token 需求组织器、MaaS 负载生成器、数据湖调用器、昇腾云利用率放大器和生态控制面。如果只把 Agent 当成“低代码应用搭建器”或“智能客服/知识问答工具”，战略价值会被低估；如果把 Agent 作为牵引 AI ","diagramCount":0},{"id":"ai-cloud-value-reconstruction","type":"research","title":"华为云 AI 时代价值重构战略研究报告","category":"产业趋势","topicId":null,"status":"published","updatedAt":null,"createdAt":null,"canonicalQuestion":"","mtime":"2026-06-12T11:40:04.593057+00:00","summary":"--- 智能体（Agent）时代的云竞争，正在从“谁有更多 GPU / NPU”转向“谁能把企业真实任务转化为可计量、可治理、可复购、可沉淀的智能运营收入”。对华为云而言，战略升级不是追逐通用大模型的技术巅峰，而是把 昇腾算力 + 盘古行业模型 + ModelArts / AgentArts / CodeArts + 行业流程资产 组合成企业级 Agent 工程平台，并以此牵引智能算力池化、混合云行业落地、软件平台组合、伙伴生态闭环和硬件持续运营。 本报告基于本地研究库（ 115 篇文章、33 个 Topics、34 个 Issue Card 目录）、上一版 Token 经济研究资产（20 个文件）、10 次 GPT 补充研究、公开","diagramCount":0},{"id":"cloud-hardware-monetization","type":"research","title":"华为云硬件变现模式研究","category":"商业观察","topicId":null,"status":"published","updatedAt":null,"createdAt":null,"canonicalQuestion":"","mtime":"2026-06-23T09:07:49.813503+00:00","summary":"--- 基于已验证外部数据（12家公司财报）和 Issue Cards（6张，35篇源文章），本报告给出 5 个判断： 1. 华为云硬件变现的最佳路径，不是从\"卖硬件\"直接跳到\"卖 Token\"，而是沿着\"硬件 → AI Colo / 专属资源池 → NPU 云 → MaaS → Agent Runtime → AI Factory\"逐层叠加。 每上一层，客户粘性增强，但交付复杂度和毛利不确定性也上升。 2. 短期最能带动硬件收入的是\"专属资源池 / AI Colo / AIDC 总包\"，不是纯 MaaS。 纯 MaaS 的 Token 收入规模和毛利高度不确定；但专属资源池可以直接带动昇腾、鲲鹏、存储、网络、液冷、供配电等 ICT","diagramCount":0},{"id":"agent-era-2035","type":"research","title":"面向 2035 的 Agent 时代：从数字助手到产业智能体，华为云 ToB/产业机会展望","category":"趋势前瞻","topicId":null,"status":"published","updatedAt":null,"createdAt":null,"canonicalQuestion":"","mtime":"2026-06-18T10:19:43.979169+00:00","summary":"--- 到 2035 年，Agent 将不再主要表现为电脑里的数字助手，而会演进为连接数字世界、物理世界和产业系统的智能执行单元。它们一端连接云端模型、行业知识、企业系统和数据平台，另一端连接汽车、机器人、工厂设备、能源设施、物流网络和城市基础设施。在这个过程中，Agent 的核心价值将从\"辅助人完成任务\"，升级为\"在治理框架下参与产业系统的感知、决策、执行和持续优化\"。 2035 年 Agent 竞争的关键，不是单个 Agent 的问答、规划或工具调用能力，而是谁能掌握完整的产业智能闭环： 2035 产业智能体 = 云端训练 × 边缘推理 × 终端执行 × 数据回流 × 仿真验证 × 运行治理 这个闭环意味着：Agent 不是一次","diagramCount":0},{"id":"cloud-vendor-competition","type":"research","title":"AI 时代云厂商竞争格局与华为云发展策略研究","category":"厂商观察","topicId":null,"status":"published","updatedAt":null,"createdAt":null,"canonicalQuestion":"","mtime":"2026-06-22T01:49:50.802283+00:00","summary":"--- - AWS 的 AI 云战略本质 ：AWS 正在从\"卖云资源\"转向\"卖智能生产力基础设施\"——通过自研芯片（Trainium/Inferentia/Graviton）控制算力成本，通过 Bedrock 成为模型分发与企业落地平台，通过 AgentCore 和 Frontier Agents 成为企业 AI 工作流入口，最终目标是成为企业 AI 应用运行的基础设施和平台，而非拥有最强模型。 - 华为云最应该学习 AWS 的地方 ：把 AI 云从\"模型能力展示\"升级为\"企业 AI 生产平台\"；强化 AI 基础设施与自研芯片的协同；建立多模型、多工具、多 Agent 的统一平台；把 AI 能力嵌入开发、运维、数据、业务流程；用标杆","diagramCount":0}],"news":[{"id":"news_b915a0a29bee3e6c916c","type":"news","title":"曝梁文锋不满内部会议泄露，DeepSeek或暂停融资；Karpathy入职Anthropic仅两月疑离职；日媒拆解宇树G1后认输：短期内赶不上中国｜AI周报","sourceId":"infoq.cn","status":"new","publishedAt":"2026-07-27T11:46:48","updatedAt":"2026-07-27T04:30:58.571490Z","summary":"","articleId":""},{"id":"news_643564400ab27cd177ec","type":"news","title":"昆仑万维押注世界模型的两大产业路径：内容创作实时、可交互，机器人先“预演”再行动","sourceId":"infoq.cn","status":"new","publishedAt":"2026-07-27T11:43:50","updatedAt":"2026-07-27T04:30:58.571490Z","summary":"","articleId":""},{"id":"news_fe3a9de1bab17b4da864","type":"news","title":"Debian 就项目中的 LLM 使用进行决议","sourceId":"oschina.net","status":"new","publishedAt":"2026-07-27T11:37:08","updatedAt":"2026-07-27T04:30:58.571490Z","summary":"","articleId":""},{"id":"news_2251112a768141327849","type":"news","title":"GPFS、Alluxio、JuiceFS 怎么选？一文看懂架构与适用场景","sourceId":"my.oschina.net","status":"new","publishedAt":"2026-07-27T11:23:42","updatedAt":"2026-07-27T04:30:58.571490Z","summary":"","articleId":""},{"id":"news_58c6ef673203676a7876","type":"news","title":"GNU C Library 2.44 发布","sourceId":"oschina.net","status":"new","publishedAt":"2026-07-27T11:10:13","updatedAt":"2026-07-27T04:30:58.571490Z","summary":"","articleId":""},{"id":"news_1ba24437330b8fa1d49f","type":"news","title":"支持版本控制的 SQL 数据库 Dolt 发布 2.0 版，新增自动存储清理和压缩功能","sourceId":"infoq.cn","status":"new","publishedAt":"2026-07-27T11:08:00","updatedAt":"2026-07-27T04:30:58.571490Z","summary":"","articleId":""},{"id":"news_8e23fb0c2baaec714ff4","type":"news","title":"首页推荐的幽灵手办怎么来的？对话海外大厂资深搜推算法专家傅聪","sourceId":"my.oschina.net","status":"new","publishedAt":"2026-07-27T11:04:48","updatedAt":"2026-07-27T04:30:58.571490Z","summary":"","articleId